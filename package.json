{
	"name": "marp-collab",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter '!.' -r --parallel dev",
		"lint": "oxlint --type-aware --deny-warnings",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"build": "pnpm --filter '!.' -r build",
		"typecheck": "pnpm --filter '!.' -r typecheck",
		"test": "pnpm --filter ./frontend test && pnpm --filter ./backend test",
		"changeset": "changeset"
	},
	"dependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@12.9.1"
}
