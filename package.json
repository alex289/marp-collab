{
	"name": "marp-collab",
	"version": "1.0.0",
	"workspaces": [
		"frontend",
		"backend"
	],
	"type": "module",
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"lint": "oxlint --type-aware --deny-warnings",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck"
	},
	"dependencies": {
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"oxlint-tsgolint": "^0.23.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@11.9.0"
}
