{
	"name": "marp-collab",
	"version": "1.0.0",
	"workspaces": [
		"frontend",
		"backend"
	],
	"type": "module",
	"scripts": {
		"lint": "oxlint --type-aware --deny-warnings",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck"
	},
	"dependencies": {
		"oxfmt": "^0.49.0",
		"oxlint": "^1.64.0",
		"oxlint-tsgolint": "^0.22.1"
	},
	"packageManager": "pnpm@11.1.1"
}
