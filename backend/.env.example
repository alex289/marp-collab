PORT=8787
URL=http://localhost:5173
DATA_PATH=./data
AUTH_SECRET=your-secret-key
# Set only if your reverse proxy overwrites this header with a trusted client IP.
# AUTH_IP_ADDRESS_HEADER=X-Real-IP
# For a forwarded chain, list the trusted proxy IPs or CIDR ranges.
# AUTH_TRUSTED_PROXIES=
NODE_ENV=development
# Enable only for MCP clients that require dynamic registration instead of CIMD.
MCP_ALLOW_DYNAMIC_CLIENT_REGISTRATION=false
GOTENBERG_URL=http://127.0.0.1:8912
AUTH_PROVIDER_0_NAME=
AUTH_PROVIDER_0_CLIENT_ID=
AUTH_PROVIDER_0_CLIENT_SECRET=
AUTH_PROVIDER_0_DISCOVERY_URL=
