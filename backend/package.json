		"@hocuspocus/server": "^4.8.0",
		"@hono/node-server": "^2.1.6",
		"@marp-team/marp-core": "^4.4.0",
		"@modelcontextprotocol/server": "^2.4.0",
		"archiver": "^8.0.0",
		"better-auth": "^1.7.19",
		"better-sqlite3": "^13.0.3",
		"hono": "^4.13.17",
		"isomorphic-git": "^1.40.5",
		"node-diff3": "^3.2.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"ws": "^8.22.2",
		"yauzl": "^3.4.0",
		"yjs": "^13.6.33",
