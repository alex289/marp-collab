{
	"name": "server",
	"version": "1.0.0",
	"description": "Realtime collaboration backend for Marp",
	"type": "module",
	"scripts": {
		"start": "node dist/app.js",
		"dev": "node --watch --env-file=.env src/app.ts",
		"build": "rolldown --config",
		"typecheck": "tsc --noEmit",
		"test": "node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@hocuspocus/server": "^4.3.0",
		"@hono/node-server": "^2.0.6",
		"archiver": "^8.0.0",
		"better-auth": "^1.6.23",
		"better-sqlite3": "^12.11.1",
		"hono": "^4.12.27",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"ws": "^8.21.0",
		"yjs": "^13.6.31",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/archiver": "^8.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.0.1",
		"@types/ws": "^8.18.1",
		"rolldown": "^1.1.3",
		"typescript": "^6.0.3"
	}
}
