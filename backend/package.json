{
	"name": "backend",
	"version": "1.0.0",
	"private": true,
	"description": "Realtime collaboration backend for Marp",
	"type": "module",
	"scripts": {
		"start": "node dist/bin/app.js",
		"dev": "node --watch --env-file=.env src/app.ts",
		"build": "rolldown --config",
		"typecheck": "tsc --noEmit",
		"test": "node --test src/**/*.test.ts"
	},
	"dependencies": {
		"@hocuspocus/server": "^4.7.0",
		"@hono/node-server": "^2.1.3",
		"@marp-team/marp-core": "^4.4.0",
		"archiver": "^8.0.0",
		"better-auth": "^1.7.7",
		"better-sqlite3": "^13.0.3",
		"hono": "^4.13.13",
		"pino": "^10.4.0",
		"pino-pretty": "^13.1.3",
		"ws": "^8.22.0",
		"yauzl": "^3.4.0",
		"yjs": "^13.6.33",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/archiver": "^8.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.4",
		"@types/ws": "^8.18.2",
		"@types/yauzl": "^3.4.0",
		"rolldown": "^1.2.12",
		"typescript": "^7.0.2"
	}
}
