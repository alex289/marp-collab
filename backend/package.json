{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "description": "Hono backend with Better Auth, Drizzle, and Yjs websocket collaboration",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/db/init.ts",
    "db:generate": "npm run db:init",
    "db:migrate": "npm run db:init"
  },
  "keywords": [
    "hono",
    "better-auth",
    "drizzle",
    "yjs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "better-auth": "^1.3.10",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.5",
    "ws": "^8.18.3",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
