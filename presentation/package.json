{
	"name": "presentation",
	"scripts": {
		"html": "marp --theme ./theme/theme.css presentation.md -o output.html",
		"pdf": "marp --theme ./theme/theme.css presentation.md -o output.pdf",
		"pptx": "marp --theme ./theme/theme.css presentation.md -o output.pptx",
		"watch": "marp --theme ./theme/theme.css -w presentation.md",
		"server": "marp --theme ./theme/theme.css -s .",
		"format": "oxfmt --write"
	},
	"dependencies": {
		"@marp-team/marp-cli": "^4.4.0",
		"oxfmt": "^0.51.0"
	}
}
